# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api

# Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable (anon) key - safe for client-side use
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXX...

# Supabase project ID (extracted from URL)
SUPABASE_PROJECT_ID=your-project-id

# Vite build-time variables (used in client-side bundles)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXX...
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-side NVIDIA API key for AI features (never expose with a VITE_ prefix)
# NVIDIA_API_KEY=nvapi-...
# Optional model override; defaults to meta/llama-3.3-70b-instruct
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
